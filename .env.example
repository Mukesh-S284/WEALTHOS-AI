# WealthOS AI Configuration

# Environment (development | testing | production)
ENVIRONMENT=development
APP_NAME=WealthOS AI
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=change-this-in-production-use-a-32-byte-random-secret-key-min-length-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
# For local development SQLite is supported out of the box:
DATABASE_URL=sqlite:///./wealthos.db
# For PostgreSQL (Docker / Production):
# DATABASE_URL=postgresql+psycopg2://wealthos_user:wealthos_password@localhost:5432/wealthos_db

# Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Market Data API Keys (Optional - Fallbacks gracefully to Yahoo Finance / CoinGecko public endpoints)
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# AI Assistant Provider Configuration
# Supported providers: gemini | mock | local
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Logging
LOG_LEVEL=INFO
